{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode Redfork",
  "identifier": "io.github.alexyaroshuk.opencode",
  "bundle": {
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/prod/32x32.png",
      "icons/prod/128x128.png",
